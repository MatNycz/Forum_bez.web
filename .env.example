# Baza: PostgreSQL (uruchamiana przez: docker compose up -d db)
DATABASE_URL=postgresql+psycopg2://forum:forum@localhost:5432/forum
# Szybki start bez Dockera (plik lokalny) - odkomentuj i zakomentuj linię wyżej:
# DATABASE_URL=sqlite:///./forum.db

SECRET_KEY=zmien-mnie-na-dlugi-losowy-ciag-min-32-znaki
TOKEN_TTL_MINUTES=60
COOKIE_SECURE=false

# Konto administratora tworzone automatycznie przy pierwszym starcie
# (tylko jeśli w bazie nie ma jeszcze żadnego admina).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345!
